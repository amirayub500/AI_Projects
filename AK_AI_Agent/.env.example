# Copy this file to .env and edit it:   cp .env.example .env
# (.env is never uploaded to GitHub - it is in .gitignore)

# Password visitors must enter (any user name). Leave empty for no password.
APP_PASSWORD=change-me

# Password for the visitor log at /admin/visits (keep it different from
# APP_PASSWORD). Empty = page turned off.
ADMIN_PASSWORD=

# Your own IP addresses (comma separated), hidden from the visitor list.
# Optional: opening /admin/visits through the domain also learns them.
OWNER_IPS=

# Which model service the agent uses:
#   anthropic  Claude API (fast, recommended)  - needs ANTHROPIC_API_KEY
#   openai     OpenAI API                      - needs OPENAI_API_KEY
#   ollama     local model on this server's CPU (slow, no key)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model name. Leave empty for the provider's default
# (anthropic: claude-haiku-5-5, openai: gpt-4o-mini, ollama: qwen3:1.7b).
MODEL=

# Only for LLM_PROVIDER=ollama: model to download
OLLAMA_MODEL=qwen3:1.7b

# Agent loop steps per research run
MAX_STEPS=5

# Research runs one visitor (IP) may start per hour
RATE_LIMIT_PER_HOUR=10

# Seconds: one model call / one whole research run
LLM_TIMEOUT=120
RESEARCH_TIMEOUT=900

# Longest topic accepted
MAX_TOPIC_CHARS=500

# Port visitors use (80 = plain http://SERVER-IP)
PUBLIC_PORT=80
